<?xml version="1.0" encoding="utf-8"?>
<!-- Demo app: one launcher activity, a framework theme, plain Views. Needs INTERNET to download
     the large model weights on demand (see the "Models" section of MainActivity). CAMERA powers the
     live-camera gesture example (CameraGestureActivity); the camera feature is optional so the app
     still installs on a camera-less emulator, where that one screen reports it cannot run. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="ai-android demo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name="hk.edu.hkmu.demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="hk.edu.hkmu.demo.camera.CameraGestureActivity"
            android:exported="false" />

    </application>

</manifest>
